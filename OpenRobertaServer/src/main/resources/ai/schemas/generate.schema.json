{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The answer of the task generate: simulation worlds with scenario tests",
  "type": "object",
  "required": ["worlds"],
  "additionalProperties": false,
  "properties": {
    "worlds": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/world"}}
  },
  "$defs": {
    "world": {
      "type": "object",
      "required": ["name", "tests"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "world": {"$ref": "#/$defs/floor"},
        "base": {"const": "existing"},
        "tests": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/test"}}
      },
      "oneOf": [{"required": ["world"]}, {"required": ["base"]}]
    },
    "floor": {
      "type": "object",
      "required": ["background", "starts", "items"],
      "additionalProperties": false,
      "properties": {
        "background": {"const": "peach"},
        "size": {"type": "object", "required": ["w", "h"], "additionalProperties": false,
                 "properties": {"w": {"type": "integer", "minimum": 50, "maximum": 600}, "h": {"type": "integer", "minimum": 50, "maximum": 600}}},
        "starts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/start"}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
      }
    },
    "start": {
      "type": "object",
      "required": ["id", "name", "x", "y", "heading"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"},
        "x": {"type": "number"}, "y": {"type": "number"}, "heading": {"type": "number"}
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "kind": {"enum": ["rect", "circle", "triangle", "line", "tunnel"]},
        "role": {"enum": ["obstacle", "goal", "fail"]},
        "x": {"type": "number"}, "y": {"type": "number"},
        "w": {"type": "number", "exclusiveMinimum": 0}, "h": {"type": "number", "exclusiveMinimum": 0},
        "r": {"type": "number", "exclusiveMinimum": 0},
        "points": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
        "smooth": {"type": "boolean"}, "closed": {"type": "boolean"},
        "width": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "test": {
      "type": "object",
      "required": ["name", "scenario", "start", "max_time_ms", "checks"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "scenario": {"type": "string", "minLength": 1, "maxLength": 400},
        "start": {"type": "string"},
        "until": {"type": ["string", "null"]},
        "max_time_ms": {"type": "integer", "minimum": 100, "maximum": 120000, "multipleOf": 100},
        "world": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "globals": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
      }
    },
    "event": {
      "oneOf": [
        {"type": "object", "required": ["event", "at"], "additionalProperties": false,
         "properties": {"event": {"const": "clap"}, "at": {"type": "integer", "minimum": 0}}},
        {"type": "object", "required": ["event", "port", "at"], "additionalProperties": false,
         "properties": {"event": {"const": "key"}, "port": {"enum": ["PLAY", "REC"]}, "at": {"type": "integer", "minimum": 0}}}
      ]
    },
    "value": {
      "oneOf": [{"type": "integer"}, {"type": "boolean"}, {"type": "array", "items": {"type": "integer"}}]
    },
    "does": {
      "enum": ["drives_forward", "drives_backward", "turns_left", "turns_right", "stands_still", "left_led_on", "left_led_off",
               "right_led_on", "right_led_off", "leds_on", "leds_off", "plays_sound", "silent"]
    },
    "check": {
      "oneOf": [
        {"type": "object", "required": ["check"], "additionalProperties": false,
         "properties": {"check": {"const": "reaches"}, "item": {"type": "string"}}},
        {"type": "object", "required": ["check"], "additionalProperties": false,
         "properties": {"check": {"const": "never_touches"}}},
        {"type": "object", "required": ["check", "item"], "additionalProperties": false,
         "properties": {"check": {"const": "ends_in"}, "item": {"type": "string"}}},
        {"type": "object", "required": ["check"], "additionalProperties": false,
         "properties": {"check": {"const": "never_bumps"}, "item": {"type": "string"}}},
        {"type": "object", "required": ["check", "does"], "additionalProperties": false,
         "properties": {"check": {"const": "does"}, "does": {"$ref": "#/$defs/does"}, "after_ms": {"type": "integer", "minimum": 0}}},
        {"type": "object", "required": ["check", "when", "does"], "additionalProperties": false,
         "properties": {"check": {"const": "whenever"},
                        "when": {"enum": ["line", "no_line", "obstacle_ahead", "obstacle_left", "obstacle_right", "no_obstacle",
                                          "left_light_below", "left_light_above", "right_light_below", "right_light_above",
                                          "sound", "play_key", "rec_key"]},
                        "percent": {"type": "integer", "minimum": 0, "maximum": 100},
                        "does": {"$ref": "#/$defs/does"}, "after_ms": {"type": "integer", "minimum": 0}}},
        {"type": "object", "required": ["check", "event", "within_ms", "does"], "additionalProperties": false,
         "properties": {"check": {"const": "after"}, "event": {"enum": ["clap", "key", "line_start", "line_end", "obstacle"]},
                        "within_ms": {"type": "integer", "minimum": 1}, "does": {"$ref": "#/$defs/does"}}},
        {"type": "object", "required": ["check", "variable", "op", "value"], "additionalProperties": false,
         "properties": {"check": {"const": "variable"}, "variable": {"type": "string"},
                        "op": {"enum": ["EQ", "NEQ", "LT", "LTE", "GT", "GTE"]}, "value": {"$ref": "#/$defs/value"}}}
      ]
    }
  }
}
