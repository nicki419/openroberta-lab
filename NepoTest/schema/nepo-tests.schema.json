{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/OpenRoberta/openroberta-lab/NepoTest/schema/nepo-tests.schema.json",
 "title": "nepotest test file",
 "description": "Unit tests for a NEPO program of the Edison V2 (see docs/ai/nepo-unit-testing.md). nepotest.validate_spec checks the same rules plus names against the program.",
 "type": "object",
 "required": ["format", "version", "program", "tests"],
 "properties": {
  "format": {"const": "nepotest"},
  "version": {"const": 1},
  "program": {"type": "string", "description": "path of the NEPO export XML, relative to this file"},
  "bundle": {"type": "string", "description": "path of the cached conversion (EdPy + source map), relative to this file"},
  "defaults": {"type": "object", "properties": {"max_time_ms": {"type": "integer", "minimum": 1}, "max_steps": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
  "tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test"}}
 },
 "$defs": {
  "test": {
   "type": "object",
   "required": ["name", "expect"],
   "additionalProperties": false,
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "origin": {"type": "string", "description": "who wrote the test, e.g. 'learner', 'teacher', 'blocks', 'ai:<model>'"},
    "block_id": {"type": "string", "description": "the id of the test block, if the test was built with NEPO test blocks"},
    "call": {"type": "string", "description": "a NEPO function name: call it instead of running the whole program"},
    "args": {"type": "array", "items": {"$ref": "#/$defs/nepoValue"}},
    "globals": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nepoValue"}, "description": "global variables to set before the call"},
    "world": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "max_time_ms": {"type": "integer", "minimum": 1},
    "max_steps": {"type": "integer", "minimum": 1},
    "expect": {"$ref": "#/$defs/expect"}
   },
   "dependentRequired": {"args": ["call"], "globals": ["call"]}
  },
  "nepoValue": {"oneOf": [{"type": "integer", "minimum": -32768, "maximum": 32767}, {"type": "boolean"},
                          {"type": "array", "items": {"type": "integer", "minimum": -32768, "maximum": 32767}}]},
  "event": {
   "type": "object",
   "required": ["event"],
   "properties": {
    "event": {"enum": ["clap", "key", "obstacle", "light", "line", "remote", "ir_message", "strain"]},
    "at": {"type": "number", "minimum": 0},
    "from": {"type": "number", "minimum": 0},
    "to": {"type": ["number", "null"], "minimum": 0},
    "port": {"enum": ["PLAY", "REC", "FRONT", "LEFT", "RIGHT", "LLIGHT", "RLIGHT", "LINETRACKER"]},
    "value": {"type": "integer"},
    "code": {"type": "integer", "minimum": 0, "maximum": 7},
    "color": {"enum": ["black", "white"]}
   }
  },
  "valueMatcher": {"oneOf": [
   {"type": ["integer", "number", "boolean", "string", "null", "array"]},
   {"type": "object", "properties": {"min": {"type": "number"}, "max": {"type": "number"}}, "additionalProperties": false, "minProperties": 1},
   {"type": "object", "properties": {"approx": {"type": "number"}, "tol": {"type": "number"}}, "required": ["approx"], "additionalProperties": false},
   {"type": "object", "properties": {"not": {}}, "required": ["not"], "additionalProperties": false}
  ]},
  "matcher": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/valueMatcher"},
              "description": "keys of an action (action, dir, block, block_id, function, port, mode, direction, power, distance_cm, degrees, power_left, power_right, frequency_hz, duration_ms, ms, value, file, sensor, t, t_end) or of a call (function, args, returns)"},
  "expect": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": false,
   "properties": {
    "returns": {"$ref": "#/$defs/valueMatcher"},
    "status": {"enum": ["finished", "running", "time_limit", "step_limit"]},
    "finished_within_ms": {"type": "number", "minimum": 0},
    "variables": {"type": "object", "additionalProperties": {"$ref": "#/$defs/valueMatcher"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/matcher"}, "description": "found in this order, other actions may be in between"},
    "actions_exactly": {"type": "array", "items": {"$ref": "#/$defs/matcher"}, "description": "all actions, in this order"},
    "no_actions": {"type": "array", "items": {"$ref": "#/$defs/matcher"}},
    "action_count": {"oneOf": [
     {"type": "object", "additionalProperties": {"$ref": "#/$defs/valueMatcher"}, "description": "block type -> number of executions"},
     {"type": "array", "items": {"type": "object", "required": ["match", "count"], "additionalProperties": false,
      "properties": {"match": {"$ref": "#/$defs/matcher"}, "count": {"$ref": "#/$defs/valueMatcher"}}}, "description": "number of actions matching each matcher"}]},
    "calls": {"type": "array", "items": {"$ref": "#/$defs/matcher"}, "description": "NEPO function calls, in this order, others may be in between"},
    "error": {"oneOf": [{"type": "null"}, {"type": "string"}, {"$ref": "#/$defs/matcher"}], "description": "null (default): no runtime error; 'any'; a kind such as 'division_by_zero'; or a matcher on kind, block_id, block_type, function"},
    "covers": {"type": "array", "items": {"type": "string"}, "description": "block ids that must be executed"},
    "states": {"type": "array", "items": {"$ref": "#/$defs/stateExpectation"}, "description": "what the robot is doing, and when (nepotest/states.py)"},
    "distance_cm": {"$ref": "#/$defs/valueMatcher", "description": "at the end: the distance driven, mean of both wheels, backward negative"},
    "heading_deg": {"$ref": "#/$defs/valueMatcher", "description": "at the end: the change of heading, counterclockwise (left) positive"},
    "end_position": {"type": "object", "additionalProperties": false,
      "properties": {"ahead_cm": {"type": "number"}, "left_cm": {"type": "number"}, "tol_cm": {"type": "number", "minimum": 0}},
      "description": "at the end: where the robot is relative to its start (ahead = its first heading, left of it), within tol_cm"}
   }
  },
  "state": {"oneOf": [
    {"type": "object", "required": ["motor"], "additionalProperties": false,
     "properties": {"motor": {"enum": ["left", "right", "both"]}, "is": {"enum": ["forward", "backward", "running", "stopped"]},
                    "power": {"$ref": "#/$defs/valueMatcher", "description": "a number: rounded like the robot does (45 to 54 mean 50); a matcher: the power it runs at"}}},
    {"type": "object", "required": ["robot"], "additionalProperties": false,
     "properties": {"robot": {"enum": ["forward", "backward", "turn_left", "turn_right", "curve_left", "curve_right", "still"]},
                    "power": {"$ref": "#/$defs/valueMatcher", "description": "only for forward, backward and the turns"}}},
    {"type": "object", "required": ["led"], "additionalProperties": false,
     "properties": {"led": {"enum": ["left", "right", "both", "either"]}, "is": {"enum": ["on", "off"]}}},
    {"type": "object", "required": ["sound"], "additionalProperties": false,
     "properties": {"sound": {"enum": ["silent", "any", "tone", "file", "beep"]}, "frequency_hz": {"$ref": "#/$defs/valueMatcher", "description": "only for tone: the NEPO frequency"}}},
    {"type": "object", "required": ["variable", "value"], "additionalProperties": false,
     "properties": {"variable": {"type": "string"}, "value": {"$ref": "#/$defs/valueMatcher"}}},
    {"type": "object", "required": ["all"], "additionalProperties": false, "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state"}}}},
    {"type": "object", "required": ["any"], "additionalProperties": false, "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state"}}}},
    {"type": "object", "required": ["not"], "additionalProperties": false, "properties": {"not": {"$ref": "#/$defs/state"}}}
  ]},
  "window": {"type": "object", "additionalProperties": false,
    "properties": {"from": {"type": "number", "minimum": 0}, "to": {"type": "number", "minimum": 0}},
    "description": "ms of program time; left out: from the program's start (after the setup block) / to the end of the run"},
  "stateEvent": {"type": "object", "required": ["event"], "additionalProperties": false,
    "properties": {"event": {"enum": ["clap", "key", "obstacle", "line", "remote", "ir_message"]}, "port": {"type": "string"},
                   "edge": {"enum": ["start", "end"], "description": "obstacle: when it appears (default) or disappears"},
                   "color": {"enum": ["black", "white"], "description": "line: when the line tracker starts to see this color"}}},
  "condition": {"oneOf": [
    {"type": "object", "required": ["obstacle"], "additionalProperties": false, "properties": {"obstacle": {"enum": ["FRONT", "LEFT", "RIGHT", "any"]}}},
    {"type": "object", "required": ["line"], "additionalProperties": false, "properties": {"line": {"enum": ["black", "white"]}}},
    {"type": "object", "required": ["light", "value"], "additionalProperties": false,
     "properties": {"light": {"enum": ["LLIGHT", "RLIGHT", "LINETRACKER"]}, "value": {"$ref": "#/$defs/valueMatcher"}}}
  ]},
  "stateExpectation": {"type": "object", "required": ["state"],
    "properties": {"state": {"$ref": "#/$defs/state"},
                   "at": {"oneOf": [{"const": "end"}, {"type": "number", "minimum": 0}]},
                   "always": {"$ref": "#/$defs/window"}, "never": {"$ref": "#/$defs/window"}, "sometime": {"$ref": "#/$defs/window"},
                   "after": {"$ref": "#/$defs/stateEvent"}, "within_ms": {"type": "number", "minimum": 0}, "each": {"type": "boolean"},
                   "while": {"$ref": "#/$defs/condition"}, "delay_ms": {"type": "number", "minimum": 0},
                   "for_ms": {"$ref": "#/$defs/valueMatcher", "description": "the time the state held, in total"},
                   "starts": {"$ref": "#/$defs/valueMatcher", "description": "how often the state began"}},
    "additionalProperties": false,
    "oneOf": [{"required": ["at"]}, {"required": ["always"]}, {"required": ["never"]}, {"required": ["sometime"]},
              {"required": ["after", "within_ms"]}, {"required": ["while"]}, {"required": ["for_ms"]}, {"required": ["starts"]}],
    "description": "exactly one timing; within_ms and each go with after, delay_ms with while"}
 }
}
