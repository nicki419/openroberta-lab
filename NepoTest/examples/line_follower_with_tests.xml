<export xmlns="http://de.fhg.iais.roberta.blockly">
    <program>
        <block_set xmlns="http://de.fhg.iais.roberta.blockly" robottype="edison" xmlversion="3.1" description="" tags="">
            <instance x="20" y="20">
                <block type="robControls_start" id="lf01" intask="true" deletable="false">
                    <mutation declare="false" />
                    <field name="DEBUG">FALSE</field>
                    <data>{"learningRate":0.03,"regularizationRate":0,"noise":0,"batchSize":10,"discretize":false,"percTrainData":50,"activationKey":"linear","activation":{},"regularization":null,"initUntil":null,"collectStats":false,"numHiddenLayers":0,"networkShape":[],"weights":[[["1"]],[[]]],"biases":[["0"],["0"]],"precision":"2","weightArcMaxSize":8,"weightSuppressMultOp":true,"inputs":["n1"],"outputs":["n2"],"hiddenNeurons":[]}</data>
                </block>
                <block type="robControls_loopForever" id="lf10" intask="true">
                    <statement name="DO">
                        <block type="robControls_ifElse" id="lf11" intask="true">
                            <mutation else="1" />
                            <repetitions>
                                <value name="IF0">
                                    <block type="robSensors_light_getSample" id="lf12" intask="true">
                                        <mutation mode="LINE" />
                                        <field name="MODE">LINE</field>
                                        <field name="SENSORPORT">LINETRACKER</field>
                                        <field name="SLOT" />
                                    </block>
                                </value>
                                <statement name="DO0">
                                    <block type="robActions_motorDiff_curve" id="lf13" intask="true">
                                        <field name="DIRECTION">FOREWARD</field>
                                        <value name="POWER_LEFT">
                                            <block type="math_number" id="lf14" intask="true">
                                                <field name="NUM">10</field>
                                            </block>
                                        </value>
                                        <value name="POWER_RIGHT">
                                            <block type="math_number" id="lf15" intask="true">
                                                <field name="NUM">40</field>
                                            </block>
                                        </value>
                                    </block>
                                </statement>
                                <statement name="ELSE">
                                    <block type="robActions_motorDiff_curve" id="lf16" intask="true">
                                        <field name="DIRECTION">FOREWARD</field>
                                        <value name="POWER_LEFT">
                                            <block type="math_number" id="lf17" intask="true">
                                                <field name="NUM">40</field>
                                            </block>
                                        </value>
                                        <value name="POWER_RIGHT">
                                            <block type="math_number" id="lf18" intask="true">
                                                <field name="NUM">10</field>
                                            </block>
                                        </value>
                                    </block>
                                </statement>
                            </repetitions>
                        </block>
                    </statement>
                </block>
            </instance>
            <instance x="500" y="20">
                <block type="robProcedures_defnoreturn" id="lf30" intask="true">
                    <mutation declare="false" />
                    <field name="NAME">toTheWall</field>
                    <statement name="STACK">
                        <block type="robActions_motorDiff_on" id="lf31" intask="true">
                            <field name="DIRECTION">FOREWARD</field>
                            <value name="POWER">
                                <block type="math_number" id="lf32" intask="true">
                                    <field name="NUM">40</field>
                                </block>
                            </value>
                        </block>
                        <block type="robControls_wait_for" id="lf33" intask="true">
                            <value name="WAIT0">
                                <block type="logic_compare" id="lf34" intask="true">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                        <block type="robSensors_getSample" id="lf35" intask="true">
                                            <mutation input="INFRARED_OBSTACLE" />
                                            <field name="SENSORTYPE">INFRARED_OBSTACLE</field>
                                            <field name="SENSORPORT">FRONT</field>
                                            <field name="SLOT" />
                                        </block>
                                    </value>
                                    <value name="B">
                                        <block type="logic_boolean" id="lf36" intask="true">
                                            <field name="BOOL">TRUE</field>
                                        </block>
                                    </value>
                                </block>
                            </value>
                        </block>
                        <block type="robActions_motorDiff_stop" id="lf37" intask="true" />
                    </statement>
                </block>
            </instance>
            <instance x="40" y="40">
                <block type="nepoTest_suite" id="nepoTestSuite" intask="true" deletable="false" />
                <block type="nepoTest_run" id="lft01" intask="true">
                    <field name="NAME">Edison track</field>
                </block>
                <block type="nepoTest_run" id="lft03" intask="true">
                    <field name="NAME">stops at the wall (no simulation)</field>
                </block>
            </instance>
            <instance x="40" y="200">
                <block type="nepoTest_world" id="lft10" intask="true">
                    <field name="NAME">Edison track</field>
                    <data>{"version":3,"world":{"background":"simpleBackgroundEdison","starts":[{"id":"A","name":"A","x":46.67,"y":10,"heading":-30},{"id":"B","name":"B","x":49.87,"y":39.25,"heading":-84.2}],"items":[{"id":"obstacle","name":"Obstacle","kind":"rect","role":"obstacle","x":64.07,"y":50.74,"w":9.63,"h":9.63},{"id":"finish","name":"Finish","kind":"circle","role":"goal","x":28,"y":67.5,"r":3.5},{"id":"shortcut","name":"Shortcut","kind":"rect","role":"fail","x":55,"y":28,"w":10,"h":10}]},"view":{"x":43.33,"y":36.67,"scale":4.5}}</data>
                    <statement name="TESTS">
                        <block type="nepoTest_simcase" id="lft20" intask="true">
                            <field name="ACTIVE">TRUE</field>
                            <field name="NAME">follows the track to the finish</field>
                            <field name="START">A</field>
                            <field name="MODE">until</field>
                            <field name="UNTIL">finish</field>
                            <field name="SECONDS">20</field>
                            <statement name="CHECKS">
                                <block type="nepoTest_check_never_touches" id="lft11" intask="true">
                                    <field name="AREA">shortcut</field>
                                </block>
                                <block type="nepoTest_check_reaches" id="lft21" intask="true">
                                    <field name="AREA">finish</field>
                                </block>
                            </statement>
                        </block>
                        <block type="nepoTest_simcase" id="lft25" intask="true">
                            <field name="ACTIVE">TRUE</field>
                            <field name="NAME">from halfway, it reaches the finish too</field>
                            <field name="START">B</field>
                            <field name="MODE">until</field>
                            <field name="UNTIL">finish</field>
                            <field name="SECONDS">10</field>
                            <statement name="CHECKS">
                                <block type="nepoTest_check_never_touches" id="lft27" intask="true">
                                    <field name="AREA">shortcut</field>
                                </block>
                                <block type="nepoTest_check_reaches" id="lft26" intask="true">
                                    <field name="AREA">finish</field>
                                </block>
                            </statement>
                        </block>
                    </statement>
                </block>
            </instance>
            <instance x="860" y="200">
                <block type="nepoTest_test" id="lft30" intask="true">
                    <field name="NAME">stops at the wall (no simulation)</field>
                    <statement name="GIVEN">
                        <block type="nepoTest_given_obstacle" id="lft31" intask="true">
                            <field name="FROM">1000</field>
                            <field name="DURATION">0</field>
                            <field name="PORT">FRONT</field>
                        </block>
                    </statement>
                    <statement name="WHEN">
                        <block type="nepoTest_when_call" id="lft32" intask="true">
                            <mutation name="toTheWall" />
                            <field name="FUNCTION">toTheWall</field>
                        </block>
                    </statement>
                    <statement name="THEN">
                        <block type="nepoTest_expect_action" id="lft33" intask="true">
                            <value name="ACTION">
                                <block type="nepoTest_action_stop" id="lft34" intask="true" />
                            </value>
                        </block>
                    </statement>
                </block>
            </instance>
        </block_set>
    </program>
    <config>
        <block_set xmlns="http://de.fhg.iais.roberta.blockly" robottype="edison" xmlversion="3.1" description="" tags="">
            <instance x="213" y="213">
                <block type="robBrick_Edison-Brick" id="1" intask="true" deletable="false"/>
            </instance>
        </block_set>
    </config>
</export>
