# The Lab's settings for the levels and the study. Copy this file to .env (it is not in git) and restart the server
# (./ora.sh start-from-git reads .env in the repository's root). Environment variables of the same names override
# .env; a "-d levels.designer=true" on the command line overrides both.

# true: the Level designer tab is shown (to draw levels and download them as files)
LEVEL_DESIGNER=false

# the folder of the level sets the Program tab's simulator plays (Edison): a folder per set, a .json file per level,
# both in the order of their names. Relative to the working directory.
LEVELS_DIR=levels

# the folder of the study's telemetry: a .jsonl file per participant (admin/ is not in git)
LEVEL_TELEMETRY_DIR=admin/levelTelemetry

# the AI test assistant (beside the simulator, on levels) calls DeepSeek-V4.1-Flash, at DeepSeek's own API (deepseek) and at SDU's
# UCloud (ucloud), in this order: the next is asked when one gives no answer (can't be reached, doesn't answer in time, an HTTP error),
# and then for 5 minutes the first is asked last. Leave one out to use only the other.
AI_PROVIDERS=deepseek,ucloud

# Each API: its key, address (OpenAI-compatible; the calls go to <url>/chat/completions, GET <url>/models lists the models of a key),
# model, and the reasoning effort of each call (none, low, high, max; empty: the model's default): the analysis before the tests (analyze),
# writing the tests (generate: one call per scenario, in parallel), fixing those that failed (fix). The assistant calls them only when the
# learner asks for tests (until 2026-11-06 a guess of what the program should do, infer, came after every changed run: _EFFORT_INFER is
# no longer read). The presets (2026-11-05, docs/ai/nepo-ai-model-evaluation.md): analyze and generate at none (10 to 20 s each;
# at low a hard program reasoned into the 32,000-token cap, and one scenario's call took 2 to 3 minutes). At none, the tests are good
# because each call is about one scenario and the context pack gives recipes for placing things from the start.
# The API keys are secrets: the server reads them on its own, never logs them and never sends them to the browser (they are no server
# properties, so "-d" can't set them). An API without a key isn't asked; without any, the assistant is not available.
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_EFFORT_ANALYZE=none
DEEPSEEK_EFFORT_GENERATE=none
DEEPSEEK_EFFORT_FIX=low

UCLOUD_API_KEY=
UCLOUD_URL=https://ai.cloud.sdu.dk/v1
UCLOUD_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
UCLOUD_EFFORT_ANALYZE=none
UCLOUD_EFFORT_GENERATE=none
UCLOUD_EFFORT_FIX=low

# true: the assistant is on for a test subject who was never switched in the Edit menu (recommended: false)
AI_TESTS_DEFAULT=false

# the folder of the assistant's context pack (its prompt), read at every call, to change the prompt without rebuilding the server, e.g.
# OpenRobertaServer/src/main/resources/ai. Empty: the pack built into the server.
AI_PACK_DIR=
