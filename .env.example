# The Lab's settings for the levels and the study. Copy this file to .env (it is not in git) and restart the server
# (./ora.sh start-from-git reads .env in the repository's root). Environment variables of the same names override
# .env; a "-d levels.designer=true" on the command line overrides both.

# true: the Level designer tab is shown (to draw levels and download them as files)
LEVEL_DESIGNER=false

# the folder of the level sets the Program tab's simulator plays (Edison): a folder per set, a .json file per level,
# both in the order of their names. Relative to the working directory.
LEVELS_DIR=levels

# the folder of the study's telemetry: a .jsonl file per participant (admin/ is not in git)
LEVEL_TELEMETRY_DIR=admin/levelTelemetry

# the AI test assistant (beside the simulator, on levels) calls DeepSeek-V4.1-Flash at SDU's UCloud first, and at DeepSeek's own API
# (the fallback) when UCloud gives no answer (can't be reached, doesn't answer in time, an HTTP error); then the fallback is asked
# first for 5 minutes. The API keys are secrets: the server reads them on its own, never logs them and never sends them to the browser
# (they are no server properties, so "-d" can't set them). Both empty: the assistant is not available; one empty: only the other is asked.
DEEPSEEK_API_KEY=

# UCloud's API (OpenAI-compatible; the calls go to <url>/chat/completions, GET <url>/models lists the models of a key) and the model
DEEPSEEK_URL=https://ai.cloud.sdu.dk/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# the fallback: DeepSeek's own API, its key and model (deepseek-flash is DeepSeek-V4.1-Flash)
DEEPSEEK_FALLBACK_API_KEY=
DEEPSEEK_FALLBACK_URL=https://api.deepseek.com
DEEPSEEK_FALLBACK_MODEL=deepseek-flash

# true: the assistant is on for a test subject who was never switched in the Edit menu (recommended: false)
AI_TESTS_DEFAULT=false

# the folder of the assistant's context pack (its prompt), read at every call, to change the prompt without rebuilding the server, e.g.
# OpenRobertaServer/src/main/resources/ai. Empty: the pack built into the server.
AI_PACK_DIR=

# the model's reasoning effort (low, high, max; empty: the model's default) for a guess of what the program should do, and for
# writing tests. At DeepSeek, higher writes more careful tests but takes much longer; at UCloud, low and high made no measurable
# difference (2026-11-05: UCloud at low reasons about as long as DeepSeek at high; writing tests took about 2.5 minutes there and
# 2 minutes at DeepSeek). Every call's effort is in the telemetry (ai_call).
AI_EFFORT_INFER=low
AI_EFFORT_GENERATE=low
